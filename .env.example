# Facebook MCP configuration
# Copy to .env and fill in as needed.

# --- transport -----------------------------------------------------------
# http = curl_cffi only; cdp = Chrome DevTools only; auto = mix
FB_TRANSPORT_MODE=auto

# --- http (curl_cffi) ----------------------------------------------------
# TLS/JA3 fingerprint to impersonate (chrome, chrome110, safari, ...)
FB_IMPERSONATE=chrome
FB_REQUEST_TIMEOUT=30
FB_MAX_RETRIES=3

# --- account store -------------------------------------------------------
# Credentials live OUTSIDE the repo, one directory per Facebook account:
#   ~/.facebook-mcp/accounts/<account>/{cookies.txt, account.json}   (mode 600)
# Populate them with tools/export_cookies.py or tools/import_cookies.py.
# Root override (default ~/.facebook-mcp):
FB_HOME=
# Which account directory is active by default:
FB_ACCOUNT=default

# --- session / auth (overrides / optional) -------------------------------
# Explicit cookie file; takes precedence over the account store.
FB_COOKIE_FILE=
# Inline cookie string, e.g. "c_user=...; xs=...". Last resort: it leaks into
# process listings and shells, so prefer the account store.
FB_COOKIE=
# Optional UA override
FB_USER_AGENT=

# --- messaging -----------------------------------------------------------
# lightspeed = send over the Messenger sync WebSocket (no browser)
# ui         = drive the Messenger DOM through CDP (fallback)
# auto       = lightspeed first, UI when the protocol path cannot be used
FB_MESSAGE_TRANSPORT=auto

# --- graphql routes -------------------------------------------------------
# doc_id rotates with every Facebook build. Normally refreshed in the account
# store (~/.facebook-mcp/accounts/<account>/account.json -> "doc_ids"), which
# tools/sniff.py --save-templates writes for you; this env var is the fallback
# for a single shared process. JSON object, op -> doc_id.
# FB_ROUTE_DOC_IDS={"search.results": "39411546341825607"}

# --- rate limiting --------------------------------------------------------
FB_MIN_REQUEST_INTERVAL=2

# --- proxy ---------------------------------------------------------------
# Explicit proxy URL, e.g. http://127.0.0.1:10808 or socks5h://127.0.0.1:10808
FB_PROXY=
# On macOS, auto-detect the system proxy (scutil --proxy) if FB_PROXY is empty
FB_PROXY_FROM_SYSTEM=true

# --- cdp (Chrome DevTools) ------------------------------------------------
# Chrome must be started with --remote-debugging-port=9222
# (see tools/launch_chrome_debug.sh)
FB_CDP_URL=http://127.0.0.1:9222
FB_CDP_PAGE_URL=https://www.facebook.com/
FB_CDP_TIMEOUT=60
# Pull cookies from the attached Chrome when FB_COOKIE / FB_COOKIE_FILE is empty
FB_CDP_COOKIE_BOOTSTRAP=true
# Write those cookies into the account store, so later runs need no browser
FB_PERSIST_BROWSER_COOKIES=true
